APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Idioma del guion. El producto es terror en inglés estadounidense con ambientación
# latinoamericana: el español aparece solo como nombres propios dentro de la narración inglesa.
# Cambiar este valor NO basta para cambiar de idioma. Hay que alinear también TTS_VOICE, el
# KOKORO_LANG del sidecar (tts-service), WHISPER_LANGUAGE y WHISPER_MODEL (ggml-base.en.bin es
# English-only: cualquier otro idioma exige la variante multilingüe). Los prompts del LLM piden la
# salida en inglés por escrito. Lista completa de puntos a tocar en AGENTS.md, "Idioma y localización".
STORY_LANGUAGE=en

# Proveedor de LLM que atiende primero: "gemini" o "anthropic".
LLM_PROVIDER=gemini

# Credencial de Google AI Studio.
GEMINI_API_KEY=
# Modelo de Gemini que escribe el guion.
GEMINI_MODEL=gemini-3.6-flash
# Modelo de Gemini que revisa el guion. Vacío: reutiliza GEMINI_MODEL.
GEMINI_REVIEW_MODEL=gemini-3.6-flash

# Respaldo con Anthropic cuando el proveedor principal está saturado o caído. En false no se
# consulta nunca, aunque haya clave. El cambio de proveedor es para toda la ejecución en curso.
AI_FEATURES_ENABLED=true
# Credencial de Anthropic. Sin ella no hay respaldo.
ANTHROPIC_API_KEY=
# Modelo de Anthropic del respaldo.
AI_MODEL=claude-haiku-4-5
# Cabecera anthropic-beta, solo si la API la exige para las salidas estructuradas. Vacío: no se manda.
ANTHROPIC_BETA=

# Motor de voz: "kokoro" (sidecar local, gratis, hay que arrancarlo) o "inworld" (API, más
# expresiva, tramo gratuito de 70 minutos al mes). Cada motor usa sus propias variables de voz y
# velocidad: las de abajo no se mezclan entre proveedores.
TTS_DRIVER=kokoro

# --- Kokoro (TTS_DRIVER=kokoro) ---
# URL base del servicio TTS local (tts-service).
TTS_BASE_URL=http://127.0.0.1:8020
# Voz de Kokoro con la que se narra la historia.
TTS_VOICE=af_heart
# Multiplicador de velocidad de la narración. 1.0 es el ritmo natural.
TTS_SPEED=1.0

# --- Inworld (TTS_DRIVER=inworld) ---
# Credencial del portal de Inworld. Va literal detrás de "Basic ": ya viene codificada, no la
# vuelvas a pasar por base64.
INWORLD_API_KEY=
# ID de voz del catálogo. Blake es íntima y contenida; Levi y Victor son las que el catálogo
# etiqueta para suspense. Lista completa: GET https://api.inworld.ai/voices/v1/voices
INWORLD_VOICE=Blake
# Velocidad. La API solo admite entre 0.5 y 1.5, y recomienda no bajar de 0.8.
INWORLD_SPEED=1.10
# Modelo. Solo inworld-tts-2 respeta la dirección de interpretación; el Flash la ignora.
INWORLD_MODEL=inworld-tts-2
# Idioma en BCP-47. Inworld rechaza "en" a secas.
INWORLD_LANGUAGE=en-US
# STABLE, BALANCED o CREATIVE. CREATIVE da más rango emocional pero se desvía más del texto, y
# eso degrada la alineación de whisper y deja efectos sin colocar.
INWORLD_DELIVERY_MODE=BALANCED

# Ejecutable de whisper.cpp usado para alinear la narración.
WHISPER_BINARY=whisper-cli
# Modelo ggml de whisper.cpp.
# Vacío: usa storage/app/whisper/ggml-base.en.bin si el fichero existe.
WHISPER_MODEL=
# Idioma que se le pasa a whisper. Debe coincidir con el del guion.
WHISPER_LANGUAGE=en
# Ruta del preset DTW de whisper.cpp para timestamps más precisos. Vacío: desactivado.
WHISPER_DTW=

# Proveedor de imágenes de IA. Hoy solo "pollinations".
IMAGE_PROVIDER=pollinations

# Token de la API de Freesound para descargar ambientes y efectos.
FREESOUND_TOKEN=
